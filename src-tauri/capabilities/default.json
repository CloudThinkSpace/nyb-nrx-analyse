{
    "$schema": "../gen/schemas/desktop-schema.json",
    "identifier": "default",
    "description": "Capability for the main window",
    "windows": ["main"],
    "permissions": [
        "core:default",
        "opener:default",
        "sql:allow-load",
        "sql:allow-execute",
        "sql:allow-select",
        "fs:allow-read-file",
        "fs:allow-write-text-file",
        "fs:allow-write-file",
        "dialog:allow-open",
        "dialog:allow-save"
    ]
}
