{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "区域农业评价",
    "version": "0.1.0",
    "identifier": "com.tanghy.nyb-nrx-analyse",
    "build": {
        "beforeDevCommand": "pnpm dev",
        "devUrl": "http://localhost:1420",
        "beforeBuildCommand": "pnpm build",
        "frontendDist": "../dist"
    },
    "app": {
        "windows": [
            {
                "label": "main",
                "title": "区域农业绿色发展水平评价软件",
                "url": "/",
                "width": 1280,
                "height": 800,
                "minWidth": 1000,
                "minHeight": 640
            }
        ],
        "security": {
            "csp": null
        }
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ]
    }
}
